digraph SignatureAuditGraph {
    # Настройки графа
    graph [rankdir=LR, nodesep=0.5, ranksep=0.8, fontname="Arial", fontsize=11, compound=true];
    node [shape=box, style="filled,rounded", fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9, color="#555555"];

    # Легенда / Стили узлов
    # Документы: Голубой (#E3F2FD)
    # Апостили: Желтый (#FFFDE7)
    # Ручные подписи (Complex Manual Signature): Зеленый (#E8F5E9)
    # Доказательные метки / Решения: Фиолетовый (#F3E5F5)

    subgraph cluster_legend {
        label = "Легенда типов узлов";
        color = lightgrey;
        style = dashed;
        leg_doc [label="Исходный документ", fillcolor="#E3F2FD"];
        leg_apostille [label="Апостиль / Реестр", fillcolor="#FFFDE7"];
        leg_sig [label="Complex Manual Signature", fillcolor="#E8F5E9"];
        leg_status [label="Юридический статус / Вывод", fillcolor="#F3E5F5"];
    }

    # --- УЗЛЫ ДОКУМЕНТОВ ---
    doc_vsp [label="Дело № 1ra-834/09\nОпределение ВСП РМ (21.07.2009)\nSHA256: 47d0d...1804", fillcolor="#E3F2FD"];
    doc_cnddcm [label="Сертификат C013564402308\nCNDDCM РМ (05.04.2021)\nSHA256: 92e2f...16f", fillcolor="#E3F2FD"];

    # --- УЗЛЫ АПОСТИЛЕЙ ---
    ap_mirzac [label="Апостиль № CG0T6Y1TBUEL7\nСекьюрити-код: 2013074491511\nПодписант: Mîrzac Iuliana (12.07.2022)", fillcolor="#FFFDE7"];
    ap_frimu [label="Апостиль № 90VS71FRKM4S3\nСекьюрити-код: 2013073942632\nПодписант: Valeriu Frimu (02.06.2021)", fillcolor="#FFFDE7"];
    ap_gorincioi [label="Апостиль № HS0W3X5SGO603\nСекьюрити-код: 2013074683466\nПодписант: Gorincioi Stelian (2022)", fillcolor="#FFFDE7"];

    # --- УЗЛЫ ПОДПИСЕЙ И ШТАМПОВ ---
    sig_mirzac_manual [label="Подпись на документе:\n'semnatura indescifrabila'\n[Complex Manual Signature]", fillcolor="#E8F5E9"];
    sig_pinzaru_manual [label="Подпись И.О. Директора CNDDCM:\nStela Pînzaru\n[Complex Manual Signature]", fillcolor="#E8F5E9"];
    sig_vsp_judges [label="Коллегия ВСП:\nГурски, Гордилэ, Плэмэдялэ,\nАлергуш, Тимофти\n[Complex Manual Signature]", fillcolor="#E8F5E9"];

    # --- УЗЛЫ ЮРИДИЧЕСКИХ ВЫВОДОВ ---
    stat_rehab [label="Полная отмена приговоров\nПрекращение дела (ст. 275 УПК РМ)\nОсвобождение из-под стражи", fillcolor="#F3E5F5"];
    stat_disability [label="Подтверждение инвалидности\nТяжелая степень (бессрочно)\nПричина: общее заболевание", fillcolor="#F3E5F5"];
    stat_audit [label="Аудиторская метка A©tor:\nПодпись визуально подтверждена,\nне является 'unclear'", fillcolor="#F3E5F5"];

    # --- СВЯЗИ В ГРАФЕ ---
    doc_vsp -> ap_mirzac [label="Заверен апостилем"];
    ap_mirzac -> sig_mirzac_manual [label="Содержит отметку"];
    sig_mirzac_manual -> stat_audit [label="Классифицировано"];

    doc_vsp -> sig_vsp_judges [label="Подписано судьями"];
    sig_vsp_judges -> stat_rehab [label="Устанавливает"];

    doc_cnddcm -> ap_frimu [label="Заверен апостилем"];
    ap_frimu -> sig_pinzaru_manual [label="Подтверждает подпись"];
    sig_pinzaru_manual -> stat_disability [label="Устанавливает"];
    sig_pinzaru_manual -> stat_audit [label="Классифицировано"];

    ap_gorincioi -> stat_audit [label="Индексировано в реестре (90+)"];
}

            },
            {
                "name": "ForensicArtifact",
                "label": "ForensicArtifact",
                "color": "#33FF57",
                "icon": "document",
                "properties": ["path", "sha256", "status", "size_bytes"]
            },
            {
                "name": "WebhookEvent",
                "label": "WebhookEvent",
                "color": "#3357FF",
                "icon": "globe",
                "properties": ["event_id", "timestamp", "status"]
            }
        ],
        "searchTemplates": [
            {
                "title": "All Evidence and Identity Links",
                "query": "MATCH (w:WebhookEvent)-[:PRODUCED_ARTIFACT]->(a:ForensicArtifact)-[:BOUND_TO_IDNP]->(idnp:IdentityAnchor) RETURN w, a, idnp",
                "description": "Loads the complete verification chain from webhook events to forensic artifacts and IDNP anchor."
            }
        ],
        "styling": {
            "nodeLabelProperty": "path",
            "relationshipLabelProperty": "type"
        }
    }

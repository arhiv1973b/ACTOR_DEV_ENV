{
    "perspective": {
        "name": "Macheret Forensic Audit Perspective",
        "description": "Pre-configured Bloom perspective for auditing identity anchors, forensic artifacts, webhooks, and UN support financial transactions.",
        "version": "1.0.0",
        "categories": [
            {
                "name": "IdentityAnchor",
                "label": "IdentityAnchor",
                "color": "#FF5733",
                "icon": "user",

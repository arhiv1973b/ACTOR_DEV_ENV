{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Copilot Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/copilot-debug.js",
      "args": ["--no-cache", "--once", "--save"],
      "env": {
        "NODE_ENV": "development",
        "GCP_LOG": "enabled",
        "GCS_BUCKET": "your-bucket-name"
      }
    }
  ]
}

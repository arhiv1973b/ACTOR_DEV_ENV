digraph FinancialSabotageUDHR {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, fillcolor=lightblue];

    subgraph cluster_legal_basis {
        label = "Legal Foundation (Primacy)";
        fillcolor=lightyellow;
        style=filled;
        
        Constitution_Art4 [label="Constitution of Moldova\nArticle 4\n(Primacy of International Standards)", fillcolor=gold];
        UDHR_Core [label="Universal Declaration of Human Rights (UDHR)\nArticles 3, 5, 8, 25", fillcolor=gold];
    }

    subgraph cluster_vectors {
        label = "Economic & Technical Sabotage Vectors";
        fillcolor=mistyrose;
        style=filled;

        Vector1 [label="Vector 1: Income Restriction\n(Cyber-sabotage & Contract Interception)"];
        Vector2 [label="Vector 2: Forced Infrastructure Expenses\n(GitHub, ChatGPT, Workspace, iCloud+, StarNet, Foto-zoom)"];
        Vector3 [label="Vector 3: Financial Logistics Attacks\n(FinComBank AJUTOR SOCIAL Extortion & Account Blocks)"];
    }

    subgraph cluster_evidence {
        label = "Cryptographic Evidence Artifacts";
        fillcolor=lightgray;
        style=filled;

        Receipt1 [label="FinComBank Receipt 1\n(15.09.2026 - 1,168 MDL)"];
        Receipt2 [label="FinComBank Receipt 2\n(15.10.2026 - 123 MDL)"];
        Aggregation [label="Financial Sabotage Aggregation Report\n(Damnum Emergens & Lucrum Cessans)"];
    }

    Constitution_Art4 -> UDHR_Core [style=bold];
    UDHR_Core -> Vector1 [label="Breach Art. 3, 25"];
    UDHR_Core -> Vector2 [label="Breach Art. 25"];
    UDHR_Core -> Vector3 [label="Breach Art. 3, 5, 8"];

    Vector3 -> Receipt1;
    Vector3 -> Receipt2;
    Receipt1 -> Aggregation;
    Receipt2 -> Aggregation;

    Aggregation -> CaseRef [label="CASE-MACHERET-1997-2026"];
    CaseRef [label="CASE-MACHERET-1997-2026\n(Continuing Consequences)", fillcolor=lightgreen];
}

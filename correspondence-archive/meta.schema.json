{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorrespondenceMetadata",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "sender": { "type": "string" },
    "recipient": { "type": "string" },
    "subject": { "type": "string" },
    "sha256": { "type": "string" },
    "drive_url": { "type": "string", "format": "uri" },
    "case_tag": { "type": "string" }
  },
  "required": ["id", "date", "sender", "recipient", "sha256", "drive_url"]
}

{
  "name": "Forensic Evidence Perspective",
  "version": "1.1",
  "nodeCategories": [
    {
      "name": "ForensicArtifact",
      "color": "#FF9900",
      "icon": "circle",
      "caption": "path"
    },
    {
      "name": "WebhookEvent",
      "color": "#3366CC",
      "icon": "hexagon",
      "caption": "event_id"
    },
    {
      "name": "IdentityAnchor",
      "color": "#33CC33",
      "icon": "square",
      "caption": "idnp"
    }
  ],
  "relationshipCategories": [
    {
      "name": "PRODUCED_ARTIFACT",
      "color": "#FF0000",
      "caption": "PRODUCED_ARTIFACT"
    },
    {
      "name": "BOUND_TO_IDNP",
      "color": "#9900FF",
      "caption": "BOUND_TO_IDNP"
    }
  ],
  "savedQueries": [
    {
      "id": "query_1",
      "name": "Show All Artifacts",
      "cypher": "MATCH (a:ForensicArtifact) RETURN a"
    },
    {
      "id": "query_2",
      "name": "Show Webhook Events",
      "cypher": "MATCH (w:WebhookEvent)-[r:PRODUCED_ARTIFACT]->(a:ForensicArtifact) RETURN w,r,a"
    },
    {
      "id": "query_3",
      "name": "Artifacts Bound to IDNP",
      "cypher": "MATCH (a:ForensicArtifact)-[r:BOUND_TO_IDNP]->(idnp:IdentityAnchor) RETURN a,r,idnp"
    },
    {
      "id": "query_4",
      "name": "Webhook Events Timeline",
      "cypher": "MATCH (w:WebhookEvent)-[r:PRODUCED_ARTIFACT]->(a:ForensicArtifact) RETURN w, r, a ORDER BY w.timestamp ASC"
    }
  ]
}

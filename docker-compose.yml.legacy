services:
  mcp-docker:
    build: mcp-docker-server
    container_name: mcp-docker
    volumes:
      - ./mcp-docker-server/run:/run
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./mcp-docker-server/forensic_air_gapped_audit.py:/app/forensic_air_gapped_audit.py:ro
      - H:/ACTOR_DEV_ENV:/audit_data:ro
    ports:
      - "8082:8080"
    environment:
      NODE_ENV: production
      MCP_LOG_LEVEL: debug
    restart: unless-stopped

  gemini-dockerfile-bridge:
    build:
      context: .
      dockerfile: Dockerfile.bridge
    container_name: gemini-dockerfile-bridge
    environment:
      - GEMINI_API_KEY=${GEMINI_API_KEY}
      - OLLAMA_HOST=http://host.docker.internal:11434
    ports:
      - "8001:8001"
    command: ["python", "-c", "import time; print('Gemini Dockerfile Bridge ready.'); time.sleep(86400)"]
    stdin_open: true
    tty: true
    restart: unless-stopped
